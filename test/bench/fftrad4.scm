(define (make-w log-n)
  (let* ((n (expt 2 log-n)) ;; number of complexes
         (result (make-vector (* 2 n))))

    (define (copy-low-lut)
      (do ((i 0 (+ i 1)))
           ((= i lut-table-size))
           (let ((index (* i 2)))
             (vector-set! result index (vector-ref low-lut index))
             (vector-set! result (+ index 1) (vector-ref low-lut (+ index 1))))))

    (define (extend-lut multiplier-lut bit-reverse-size bit-reverse-multiplier start end)

      (define (bitwise-and1 x) (modulo x 2))

      (define (bit-reverse x n)
        (do ((i 0 (+ i 1))
             (x x (arithmetic-shift x -1))
             (result 0 (+ (* result 2) (bitwise-and1 x))))
             ((= i n) result)))

      (let loop ((i start) (j 1))
        (if (< i end)
            (let* ((multiplier-index
                      (* 2 (* (bit-reverse j bit-reverse-size) bit-reverse-multiplier)))
                   (multiplier-real (vector-ref multiplier-lut multiplier-index))
                   (multiplier-imag (vector-ref multiplier-lut (+ multiplier-index 1))))
              (let inner ((i i) (k 0))
                ;; we copy complex multiples of all entries below
                ;; start to entries starting at start
                (if (< k start)
                    (let* ((index (* k 2))
                           (real (vector-ref result index))
                           (imag (vector-ref result (+ index 1)))
                           (result-real (- (* multiplier-real real) (* multiplier-imag imag)))
                           (result-imag (+ (* multiplier-real imag) (* multiplier-imag real)))
                           (result-index (* i 2)))
                      (vector-set! result result-index result-real)
                      (vector-set! result (+ result-index 1) result-imag)
                      (inner (+ i 1) (+ k 1)))
                    (loop i (+ j 1)))))
            result)))

    (cond
      ((<= n lut-table-size) low-lut)
      ((<= n lut-table-size^2)
        (copy-low-lut)
        (extend-lut med-lut
                    (- log-n log-lut-table-size)
                    (arithmetic-shift 1 (- (* 2 log-lut-table-size) log-n))
                    lut-table-size
                    n))
      ((<= n lut-table-size^3)
        (copy-low-lut)
        (extend-lut med-lut log-lut-table-size 1 lut-table-size lut-table-size^2)
        (extend-lut high-lut
                    (- log-n (* 2 log-lut-table-size))
                    (arithmetic-shift 1 (- (* 3 log-lut-table-size) log-n))
                    lut-table-size^2
                    n))
      (else (error "asking for too large a table")))))

(define (direct-fft-recursive-4 a W-table)

  ;; This is a direcct complex fft, using a decimation-in-time
  ;; algorithm with inputs in natural order and outputs in
  ;; bit-reversed order.  The table of "twiddle" factors is in
  ;; bit-reversed order.

  ;; this is from page 66 of Chu and George, except that we have
  ;; combined passes in pairs to cut the number of passes through
  ;; the vector a

  (let ((W (vector 0.0 0.0 0.0 0.0)))

    (define (main-loop M N K SizeOfGroup)

      (let inner-loop ((K K) (JFirst M))

        (if (< JFirst N)

            (let* ((JLast (+ JFirst SizeOfGroup)))

              (if (even? K)
                  (begin
                    (vector-set! W 0 (vector-ref W-table K))
                    (vector-set! W 1 (vector-ref W-table (+ K 1))))
                  (begin
                    (vector-set! W 0 (- 0.0 (vector-ref W-table K)))
                    (vector-set! W 1 (vector-ref W-table (- K 1)))))

              ;; we know the that the next two complex roots of
              ;; unity have index 2K and 2K+1 so that the 2K+1
              ;; index root can be gotten from the 2K index root
              ;; in the same way that we get W_0 and W_1 from the
              ;; table depending on whether K is even or not

              (vector-set! W 2 (vector-ref W-table (* K 2)))
              (vector-set! W 3 (vector-ref W-table (+ (* K 2) 1)))

              (let J-loop ((J0 JFirst))
                (if (< J0 JLast)

                    (let* ((J0 J0)
                           (J1 (+ J0 1))
                           (J2 (+ J0 SizeOfGroup))
                           (J3 (+ J2 1))
                           (J4 (+ J2 SizeOfGroup))
                           (J5 (+ J4 1))
                           (J6 (+ J4 SizeOfGroup))
                           (J7 (+ J6 1)))

                      (let ((W_0 (vector-ref W 0))
                            (W_1 (vector-ref W 1))
                            (W_2 (vector-ref W 2))
                            (W_3 (vector-ref W 3))
                            (a_J0 (vector-ref a J0))
                            (a_J1 (vector-ref a J1))
                            (a_J2 (vector-ref a J2))
                            (a_J3 (vector-ref a J3))
                            (a_J4 (vector-ref a J4))
                            (a_J5 (vector-ref a J5))
                            (a_J6 (vector-ref a J6))
                            (a_J7 (vector-ref a J7)))

                        ;; first we do the (overlapping) pairs of
                        ;; butterflies with entries 2*SizeOfGroup
                        ;; apart.

                        (let ((Temp_0 (- (* W_0 a_J4) (* W_1 a_J5)))
                              (Temp_1 (+ (* W_0 a_J5) (* W_1 a_J4)))
                              (Temp_2 (- (* W_0 a_J6) (* W_1 a_J7)))
                              (Temp_3 (+ (* W_0 a_J7) (* W_1 a_J6))))

                          (let ((a_J0 (+ a_J0 Temp_0))
                                (a_J1 (+ a_J1 Temp_1))
                                (a_J2 (+ a_J2 Temp_2))
                                (a_J3 (+ a_J3 Temp_3))
                                (a_J4 (- a_J0 Temp_0))
                                (a_J5 (- a_J1 Temp_1))
                                (a_J6 (- a_J2 Temp_2))
                                (a_J7 (- a_J3 Temp_3)))

                            ;; now we do the two (disjoint) pairs
                            ;; of butterflies distance SizeOfGroup
                            ;; apart, the first pair with W2+W3i,
                            ;; the second with -W3+W2i

                            ;; we rewrite the multipliers so I
                            ;; don't hurt my head too much when
                            ;; thinking about them.

                            (let ((W_0 W_2) (W_1 W_3) (W_2 (- 0.0 W_3)) (W_3 W_2))

                              (let ((Temp_0 (- (* W_0 a_J2) (* W_1 a_J3)))
                                    (Temp_1 (+ (* W_0 a_J3) (* W_1 a_J2)))
                                    (Temp_2 (- (* W_2 a_J6) (* W_3 a_J7)))
                                    (Temp_3 (+ (* W_2 a_J7) (* W_3 a_J6))))

                                (let ((a_J0 (+ a_J0 Temp_0))
                                      (a_J1 (+ a_J1 Temp_1))
                                      (a_J2 (- a_J0 Temp_0))
                                      (a_J3 (- a_J1 Temp_1))
                                      (a_J4 (+ a_J4 Temp_2))
                                      (a_J5 (+ a_J5 Temp_3))
                                      (a_J6 (- a_J4 Temp_2))
                                      (a_J7 (- a_J5 Temp_3)))

                                  (vector-set! a J0 a_J0)
                                  (vector-set! a J1 a_J1)
                                  (vector-set! a J2 a_J2)
                                  (vector-set! a J3 a_J3)
                                  (vector-set! a J4 a_J4)
                                  (vector-set! a J5 a_J5)
                                  (vector-set! a J6 a_J6)
                                  (vector-set! a J7 a_J7)

                                  (J-loop (+ J0 2)))))))))
                    (inner-loop (+ K 1) (+ JFirst (* SizeOfGroup 4)))))))))

    (define (recursive-bit M N K SizeOfGroup)
      (if (<= 2 SizeOfGroup)
          (begin
            (main-loop M N K SizeOfGroup)
            (if (< 2048 (- N M))
                (let ((new-size (arithmetic-shift (- N M) -2)))
                  (recursive-bit M (+ M new-size) (* K 4) (arithmetic-shift SizeOfGroup -2))
                  (recursive-bit (+ M new-size)
                                 (+ M (* new-size 2))
                                 (+ (* K 4) 1)
                                 (arithmetic-shift SizeOfGroup -2))
                  (recursive-bit (+ M (* new-size 2))
                                 (+ M (* new-size 3))
                                 (+ (* K 4) 2)
                                 (arithmetic-shift SizeOfGroup -2))
                  (recursive-bit (+ M (* new-size 3))
                                 N
                                 (+ (* K 4) 3)
                                 (arithmetic-shift SizeOfGroup -2)))
                (recursive-bit M N (* K 4) (arithmetic-shift SizeOfGroup -2))))))

    (define (radix-2-pass a)

      ;; If we're here, the size of our (conceptually complex)
      ;; array is not a power of 4, so we need to do a basic radix
      ;; two pass with w=1 (so W[0]=1.0 and W[1] = 0.)  and then
      ;; call recursive-bit appropriately on the two half arrays.

      (let ((SizeOfGroup (arithmetic-shift (vector-length a) -1)))
        (let loop ((J0 0))
          (if (< J0 SizeOfGroup)
              (let ((J0 J0) (J2 (+ J0 SizeOfGroup)))
                (let ((J1 (+ J0 1)) (J3 (+ J2 1)))
                  (let ((a_J0 (vector-ref a J0))
                        (a_J1 (vector-ref a J1))
                        (a_J2 (vector-ref a J2))
                        (a_J3 (vector-ref a J3)))
                    (let ((a_J0 (+ a_J0 a_J2))
                          (a_J1 (+ a_J1 a_J3))
                          (a_J2 (- a_J0 a_J2))
                          (a_J3 (- a_J1 a_J3)))
                      (vector-set! a J0 a_J0)
                      (vector-set! a J1 a_J1)
                      (vector-set! a J2 a_J2)
                      (vector-set! a J3 a_J3)
                      (loop (+ J0 2))))))))))

    (let* ((n (vector-length a)) (log_n (two^p>=m n)))

      ;; there are n/2 complex entries in a; if n/2 is not a power
      ;; of 4, then do a single radix-2 pass and do the rest of
      ;; the passes as radix-4 passes

      (if (odd? log_n)
          (recursive-bit 0 n 0 (arithmetic-shift n -2))
          (let ((n/2 (arithmetic-shift n -1)) (n/8 (arithmetic-shift n -3)))
            (radix-2-pass a)
            (recursive-bit 0 n/2 0 n/8)
            (recursive-bit n/2 n 1 n/8))))))

(define (inverse-fft-recursive-4 a W-table)

  ;; This is an complex fft, using a decimation-in-frequency algorithm
  ;; with inputs in bit-reversed order and outputs in natural order.

  ;; The organization of the algorithm has little to do with the the
  ;; associated algorithm on page 41 of Chu and George,
  ;; I just reversed the operations of the direct algorithm given
  ;; above (without dividing by 2 each time, so that this has to
  ;; be "normalized" by dividing by N/2 at the end.

  ;; The table of "twiddle" factors is in bit-reversed order.

  (let ((W (vector 0.0 0.0 0.0 0.0)))

    (define (main-loop M N K SizeOfGroup)
      (let inner-loop ((K K) (JFirst M))
        (if (< JFirst N)
            (let* ((JLast (+ JFirst SizeOfGroup)))
              (if (even? K)
                  (begin
                    (vector-set! W 0 (vector-ref W-table K))
                    (vector-set! W 1 (vector-ref W-table (+ K 1))))
                  (begin
                    (vector-set! W 0 (- 0.0 (vector-ref W-table K)))
                    (vector-set! W 1 (vector-ref W-table (- K 1)))))
              (vector-set! W 2 (vector-ref W-table (* K 2)))
              (vector-set! W 3 (vector-ref W-table (+ (* K 2) 1)))
              (let J-loop ((J0 JFirst))
                (if (< J0 JLast)
                    (let* ((J0 J0)
                           (J1 (+ J0 1))
                           (J2 (+ J0 SizeOfGroup))
                           (J3 (+ J2 1))
                           (J4 (+ J2 SizeOfGroup))
                           (J5 (+ J4 1))
                           (J6 (+ J4 SizeOfGroup))
                           (J7 (+ J6 1)))
                      (let ((W_0 (vector-ref W 0))
                            (W_1 (vector-ref W 1))
                            (W_2 (vector-ref W 2))
                            (W_3 (vector-ref W 3))
                            (a_J0 (vector-ref a J0))
                            (a_J1 (vector-ref a J1))
                            (a_J2 (vector-ref a J2))
                            (a_J3 (vector-ref a J3))
                            (a_J4 (vector-ref a J4))
                            (a_J5 (vector-ref a J5))
                            (a_J6 (vector-ref a J6))
                            (a_J7 (vector-ref a J7)))
                        (let ((W_00 W_2) (W_01 W_3) (W_02 (- 0.0 W_3)) (W_03 W_2))
                          (let ((Temp_0 (- a_J0 a_J2))
                                (Temp_1 (- a_J1 a_J3))
                                (Temp_2 (- a_J4 a_J6))
                                (Temp_3 (- a_J5 a_J7)))
                            (let ((a_J0 (+ a_J0 a_J2))
                                  (a_J1 (+ a_J1 a_J3))
                                  (a_J4 (+ a_J4 a_J6))
                                  (a_J5 (+ a_J5 a_J7))
                                  (a_J2 (+ (* W_00 Temp_0) (* W_01 Temp_1)))
                                  (a_J3 (- (* W_00 Temp_1) (* W_01 Temp_0)))
                                  (a_J6 (+ (* W_02 Temp_2) (* W_03 Temp_3)))
                                  (a_J7 (- (* W_02 Temp_3) (* W_03 Temp_2))))
                              (let ((Temp_0 (- a_J0 a_J4))
                                    (Temp_1 (- a_J1 a_J5))
                                    (Temp_2 (- a_J2 a_J6))
                                    (Temp_3 (- a_J3 a_J7)))
                                (let ((a_J0 (+ a_J0 a_J4))
                                      (a_J1 (+ a_J1 a_J5))
                                      (a_J2 (+ a_J2 a_J6))
                                      (a_J3 (+ a_J3 a_J7))
                                      (a_J4 (+ (* W_0 Temp_0) (* W_1 Temp_1)))
                                      (a_J5 (- (* W_0 Temp_1) (* W_1 Temp_0)))
                                      (a_J6 (+ (* W_0 Temp_2) (* W_1 Temp_3)))
                                      (a_J7 (- (* W_0 Temp_3) (* W_1 Temp_2))))
                                  (vector-set! a J0 a_J0)
                                  (vector-set! a J1 a_J1)
                                  (vector-set! a J2 a_J2)
                                  (vector-set! a J3 a_J3)
                                  (vector-set! a J4 a_J4)
                                  (vector-set! a J5 a_J5)
                                  (vector-set! a J6 a_J6)
                                  (vector-set! a J7 a_J7)
                                  (J-loop (+ J0 2)))))))))
                    (inner-loop (+ K 1) (+ JFirst (* SizeOfGroup 4)))))))))

    (define (recursive-bit M N K SizeOfGroup)
      (if (<= 2 SizeOfGroup)
          (begin
            (if (< 2048 (- N M))
                (let ((new-size (arithmetic-shift (- N M) -2)))
                  (recursive-bit M (+ M new-size) (* K 4) (arithmetic-shift SizeOfGroup -2))
                  (recursive-bit (+ M new-size)
                                 (+ M (* new-size 2))
                                 (+ (* K 4) 1)
                                 (arithmetic-shift SizeOfGroup -2))
                  (recursive-bit (+ M (* new-size 2))
                                 (+ M (* new-size 3))
                                 (+ (* K 4) 2)
                                 (arithmetic-shift SizeOfGroup -2))
                  (recursive-bit (+ M (* new-size 3))
                                 N
                                 (+ (* K 4) 3)
                                 (arithmetic-shift SizeOfGroup -2)))
                (recursive-bit M N (* K 4) (arithmetic-shift SizeOfGroup -2)))
            (main-loop M N K SizeOfGroup))))

    (define (radix-2-pass a)
      (let ((SizeOfGroup (arithmetic-shift (vector-length a) -1)))
        (let loop ((J0 0))
          (if (< J0 SizeOfGroup)
              (let ((J0 J0) (J2 (+ J0 SizeOfGroup)))
                (let ((J1 (+ J0 1)) (J3 (+ J2 1)))
                  (let ((a_J0 (vector-ref a J0))
                        (a_J1 (vector-ref a J1))
                        (a_J2 (vector-ref a J2))
                        (a_J3 (vector-ref a J3)))
                    (let ((a_J0 (+ a_J0 a_J2))
                          (a_J1 (+ a_J1 a_J3))
                          (a_J2 (- a_J0 a_J2))
                          (a_J3 (- a_J1 a_J3)))
                      (vector-set! a J0 a_J0)
                      (vector-set! a J1 a_J1)
                      (vector-set! a J2 a_J2)
                      (vector-set! a J3 a_J3)
                      (loop (+ J0 2))))))))))

    (let* ((n (vector-length a)) (log_n (two^p>=m n)))
      (if (odd? log_n)
          (recursive-bit 0 n 0 (arithmetic-shift n -2))
          (let ((n/2 (arithmetic-shift n -1)) (n/8 (arithmetic-shift n -3)))
            (recursive-bit 0 n/2 0 n/8)
            (recursive-bit n/2 n 1 n/8)
            (radix-2-pass a))))))

(define (two^p>=m m)
  ;; returns smallest p, assumes fixnum m >= 0
  (do ((p 0 (+ p 1)) (two^p 1 (* two^p 2))) ((<= m two^p) p)))

(define n 18) ;; Works on 2^n complex doubles.
(define two^n+1 (expt 2 (+ n 1)))
(define inexact-two^-n (/ (exact->inexact (expt 2 n))))

(define data
  ;; A float vector with data[i]=i
  (let ((result (make-vector two^n+1)))
    (do ((i 0 (+ i 1)))
         ((= i two^n+1) result)
         (vector-set! result i (exact->inexact i)))))

(define (run data)
  (let ((table (make-w (- n 1))))
    (direct-fft-recursive-4 data table)
    (inverse-fft-recursive-4 data table)
    (do ((j 0 (+ j 1)))
         ((= j two^n+1))
         (vector-set! data j (* (vector-ref data j) inexact-two^-n)))
    (vector-ref data 3)))

(let ((r (run data))) (pp (< (- r 3.0) 0.0001)))

;#t


