(define (pp x) (display x) (newline))

(define (pow2 k)
  (let loop ((i k) (acc 1)) (if (= i 0) acc (loop (- i 1) (* acc 2)))))

(define (arithmetic-shift x k)
  (cond
    ((= k 0) x)

    ;; left shift
    ((> k 0) (* x (pow2 k)))

    ;; right shift (arithmetic)
    (else
      (let* ((d (pow2 (- k))))
        (if (>= x 0)
            (quotient x d)
            ;; adjust for arithmetic (floor) behavior
            (- (quotient (- x) d)))))))
