(define (check text real imag)
  (let ((actual (string->number text)))
    (if (not (and actual
                  (= (real-part actual) real)
                  (= (imag-part actual) imag)))
        (error "complex rational parsing mismatch" text actual))))

(check "11/5-2/5i" 11/5 -2/5)
(check "-11/5+2/5i" -11/5 2/5)
(check "-11/5-2/5i" -11/5 -2/5)
(check "11/5+2/5i" 11/5 2/5)
(check "-2/5i" 0 -2/5)
(check "#e-11/5-2/5i" -11/5 -2/5)
(check "#x-b/5-2/5i" -11/5 -2/5)
(if (not (= 11/5-2/5i (make-rectangular 11/5 -2/5)))
    (error "complex rational literal mismatch"))
(if (not (= (string->number "-2/5") -2/5))
    (error "real rational parsing mismatch"))
(display "complex-rational-parsing-ok")
(newline)
