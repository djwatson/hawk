;;; eval
(define inited #f)

(define (eval foo env)
  (display "EVAL:")
  (display foo)
  (display "\n")
  (flush-output-port)
  (expand-program '((import (core primitive))) "REPL" #t)
  (unless inited
    (set! inited #t)
    (expand-program '((import (scheme base) (scheme process-context))) "REPL" #t))
  (let ((ir (expand-program `(,foo) "REPL" #t)))
    (if (null? ir)
        #f
        (let* ((program `#(begin ,ir #f))
               (roots (compile-ir-to-bitcode program))
               (payload (roots->runtime-payload roots)))
          (newline)
          (display "RUNNING...\n")
          (display ir)
          (display (ir->sexp program))
          (newline)
          (for-each print-bc roots)
          (flush-output-port)
          ((sys:FOREIGN_CALL '(gc_obj "scm_emit_bitcode_closure" (gc_obj)) payload))))))
